---
import site from '../data/site.json';
import { withBase } from '../lib/url';

// ナビゲーション項目。必須コンテンツ 7 項目に対応。
const nav = [
  { href: '/about', label: '研究室概要' },
  { href: '/research', label: '研究テーマ' },
  { href: '/members', label: 'メンバー' },
  { href: '/publications', label: '業績' },
  { href: '/equipment', label: '装置・設備' },
  { href: '/join', label: '進学・配属希望の方へ' },
  { href: '/access', label: 'アクセス' },
];
const current = Astro.url.pathname;
---
<header class="site-header">
  <div class="container header-inner">
    <a class="brand" href={withBase('/')}>
      <span class="brand-main">{site.labName}</span>
      <span class="brand-sub">{site.labNameShort}</span>
    </a>
    <nav aria-label="メインナビゲーション">
      <ul>
        {nav.map((item) => (
          <li>
            <a
              href={withBase(item.href)}
              aria-current={current.startsWith(withBase(item.href)) ? 'page' : undefined}
            >{item.label}</a>
          </li>
        ))}
      </ul>
    </nav>
  </div>
</header>
