---
import Base from '../layouts/Base.astro';
import site from '../data/site.json';
---
<Base title="アクセス・連絡先">
  <h1>アクセス・連絡先</h1>
  <h2>所在地</h2>
  <p>{site.university}</p>
  <p>{site.address}</p>
  <h2>交通案内</h2>
  <p>{site.accessNote}</p>
  {site.mapEmbedUrl && (
    <iframe src={site.mapEmbedUrl} width="100%" height="360" style="border:0" loading="lazy" title="地図"></iframe>
  )}
  <h2>連絡先</h2>
  <p>{site.email}</p>
</Base>
