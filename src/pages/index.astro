---
// トップページ = ゲーム画面。会話に使うデータは YAML/JSON から集めて <script id="game-data"> に埋め込む。
// 通常の文章ページ（about, members, ...）はメニューから開ける「説明書」として残している。
import site from '../data/site.json';
import { getCollection } from 'astro:content';
import { withBase } from '../lib/url';

const fmtDate = (d: Date) => d.toISOString().slice(0, 10).replace(/-/g, '.');
const members = (await getCollection('members')).sort((a, b) => a.data.order - b.data.order)
  .map(({ id, data }) => ({ id, name: data.name, nameEn: data.nameEn, role: data.role, group: data.group, interests: data.interests, bio: data.bio }));
const equipment = (await getCollection('equipment')).map(({ data }) => ({ name: data.name, description: data.description }));
const publications = (await getCollection('publications')).map(({ data }) => ({ title: data.title, venue: data.venue, year: data.year, number: data.number }))
  .sort((a, b) => (b.number ?? 0) - (a.number ?? 0));
const research = (await getCollection('research')).sort((a, b) => a.data.order - b.data.order)
  .map(({ id, data }) => ({ id, title: data.title, summary: data.summary }));
const news = (await getCollection('news')).sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .map(({ data }) => ({ title: data.title, date: fmtDate(data.date) }));
const pages = [
  { label: '研究室概要', href: withBase('/about') },
  { label: '研究テーマ', href: withBase('/research') },
  { label: 'メンバー', href: withBase('/members') },
  { label: '業績', href: withBase('/publications') },
  { label: '装置・設備', href: withBase('/equipment') },
  { label: '進学・配属希望の方へ', href: withBase('/join') },
  { label: 'アクセス', href: withBase('/access') },
];
const data = { base: import.meta.env.BASE_URL, home: withBase('/home'), site, members, equipment, publications, research, news, pages };
// </script> で埋め込みが壊れないように < をエスケープ
const json = JSON.stringify(data).replace(/</g, '\\u003c');
const pageTitle = site.labName + '｜' + site.labNameAlt + ' - ' + site.universityEn;
---
<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{pageTitle}</title>
    <meta name="description" content={site.description} />
    <meta name="theme-color" content="#000000" />
    <link rel="icon" type="image/svg+xml" href={withBase('/favicon.svg')} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=DotGothic16&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href={withBase('/game/game.css')} />
  </head>
  <body>
    <!-- ローディング画面（同じタブでは初回のみ。クリックで飛ばせる） -->
    <div id="loader" role="status" aria-live="polite">
      <div class="load-title">NOW LOADING</div>
      <div class="load-bar"><i id="load-fill"></i><canvas id="load-walker" class="load-walker" width="16" height="20"></canvas></div>
      <div class="load-pct" id="load-pct">0%</div>
      <p class="load-tip">TIP: 矢印キーで移動、Z で決定。スマートフォンは画面下のボタンで操作できます。<br />クリックでスキップ</p>
    </div>
    <div id="stage">
      <canvas id="game" aria-label="材料創製力学研究室 ウエスト4号館 4F（ゲーム画面）"></canvas>
      <div id="scan"></div>
    </div>
    <div id="controls">
      <div class="pad">
        <button data-k="up" aria-label="上">▲</button><button data-k="left" aria-label="左">◀</button>
        <button data-k="right" aria-label="右">▶</button><button data-k="down" aria-label="下">▼</button>
      </div>
      <div class="btns"><button data-k="menu" class="small">MENU</button><button data-k="b">B</button><button data-k="a">A</button></div>
    </div>
    <noscript>
      <p style="padding:16px">このページはゲーム画面として動作します。JavaScript が無効の場合は <a href={withBase('/about')} style="color:#ffe066">研究室概要</a> からご覧ください。</p>
    </noscript>
    <nav class="sr-nav" aria-label="ページ一覧">
      {pages.map((p) => <a href={p.href}>{p.label}</a>)}
    </nav>
    <script is:inline id="game-data" type="application/json" set:html={json}></script>
    <script is:inline type="module" src={withBase('/game/main.js')}></script>
    <script is:inline type="module" src={withBase('/home.js')}></script>
  </body>
</html>
