---
// トップページ: ローディング演出 → ゲームのスタート画面（ヒーロー）→ CONTACT → MINI GAME → LINE UP
import site from '../data/site.json';
import { getCollection } from 'astro:content';
import { withBase } from '../lib/url';

const research = await getCollection('research');
const members = await getCollection('members');
const publications = await getCollection('publications');
const equipment = await getCollection('equipment');
const play = withBase('/play');
const lineup = [
  { label: '研究室概要', en: 'ABOUT', href: withBase('/about'), desc: site.foundedText + '。原子拡散を駆使した「原子・ナノスケールのモノづくり」を提案しています。' },
  { label: '研究テーマ', en: 'RESEARCH', href: withBase('/research'), desc: research.length + ' つのテーマ。ナノワイヤ創製、Nano AM、電子と欠陥、結晶組織デザイン。' },
  { label: 'メンバー', en: 'MEMBERS', href: withBase('/members'), desc: '教員・学生 ' + members.filter((m) => m.data.group !== 'alumni').length + ' 名。メンバー募集中です。' },
  { label: '業績', en: 'PUBLICATIONS', href: withBase('/publications'), desc: '査読付き論文 ' + publications.length + ' 件を掲載（2024 年以降。順次追加）。' },
  { label: '装置・設備', en: 'APPARATUS', href: withBase('/equipment'), desc: equipment.length + ' 点。成膜・焼結から電子顕微鏡その場観察まで。' },
  { label: '進学・配属希望の方へ', en: 'JOIN US', href: withBase('/join'), desc: '研究室見学・Web 面談は随時受け付けています。' },
  { label: 'アクセス', en: 'ACCESS', href: withBase('/access'), desc: '伊都キャンパス ウエスト4号館 428 / 414 / 401 室。' },
];
const heroData = { base: import.meta.env.BASE_URL, play, site: { labName: site.labName }, pages: [] };
const json = JSON.stringify(heroData).replace(/</g, '\\u003c');
const mapUrl = 'https://www.google.com/maps/search/?api=1&query=' + encodeURIComponent('九州大学 伊都キャンパス ウエスト4号館');
---
<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{site.labName}｜{site.labNameAlt} - {site.universityEn}</title>
    <meta name="description" content={site.description} />
    <meta name="theme-color" content="#07070f" />
    <link rel="icon" type="image/svg+xml" href={withBase('/favicon.svg')} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=DotGothic16&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href={withBase('/home.css')} />
  </head>
  <body>
    <!-- ローディング画面（同じタブでは初回のみ。クリックで飛ばせる） -->
    <div id="loader" role="status" aria-live="polite">
      <div class="load-title">NOW LOADING</div>
      <div class="load-bar"><i id="load-fill"></i><canvas id="load-walker" class="load-walker" width="16" height="20"></canvas></div>
      <div class="load-pct" id="load-pct">0%</div>
      <p class="load-tip">TIP: 矢印キーで移動、Z で決定。スマートフォンは画面下のボタンで操作できます。<br />クリックでスキップ</p>
    </div>

    <header class="nav">
      <div class="wrap">
        <a class="brand" href={withBase('/')}><b></b>M2D LAB</a>
        <ul>
          <li><a href="#contact">CONTACT</a></li>
          <li><a href="#game">MINI GAME</a></li>
          <li><a href="#lineup">LINE UP</a></li>
          <li><a href={play}>PLAY</a></li>
        </ul>
      </div>
    </header>

    <!-- ① ゲームのスタート画面 -->
    <section class="hero" aria-label="スタート画面">
      <div class="hero-frame">
        <canvas id="game" data-mode="hero" aria-label="M2D LAB タイトル画面。クリックでゲームを開始"></canvas>
        <div class="hero-caption">
          <span>{site.labName}｜{site.labNameAlt}　{site.universityEn}</span>
          <a href={play}>PRESS START → ゲームで研究室を歩く</a>
        </div>
      </div>
    </section>

    <!-- ② CONTACT -->
    <section class="section" id="contact">
      <div class="wrap">
        <div class="sec-head"><h2>CONTACT</h2><span>連絡先・アクセス</span></div>
        <div class="contact-grid">
          <div class="panel">
            <h3>所在地</h3>
            <address>
              〒{site.postalCode} {site.address}<br />
              {site.university}<br />
              {site.labName}（{site.labNameAlt}）<br />
              {site.rooms}<br />
              <span class="en">{site.labNameEn}<br />{site.universityEn}<br />{site.addressEn}</span>
            </address>
            <p style="margin-top:16px"><a class="btn" href={mapUrl} target="_blank" rel="noopener">MAP ↗</a></p>
          </div>
          <div class="panel">
            <h3>お問い合わせ</h3>
            <p>研究室に興味がある方は問い合わせフォームからどうぞ。研究室見学・Web 面談は随時対応します。</p>
            <p class="en">If you are interested in our laboratory, please contact us via the form. Lab tours and web consultations are available at any time.</p>
            <p><a class="btn btn-primary" href={site.contactFormUrl} target="_blank" rel="noopener">問い合わせフォーム ↗</a></p>
          </div>
        </div>
      </div>
    </section>

    <!-- ③ MINI GAME -->
    <section class="section" id="game">
      <div class="wrap">
        <div class="sec-head"><h2>MINI GAME</h2><span>ゲームで研究室を歩く</span></div>
        <div class="game-intro">
          <div class="game-copy">
            <h3><small>WEST ZONE 4 / 4F</small>ウエスト4号館 たんけん RPG</h3>
            <p>伊都キャンパス ウエスト地区の町から、ウエスト4号館の 4F へ。教員室で先生に話を聞き、実験室で装置を調べ、学生居室の本棚で論文を眺める。研究室の中身を、歩いて知るミニゲームです。</p>
            <table class="controls-table">
              <tr><td>移動</td><td>矢印キー / WASD（スマホは十字ボタン）</td></tr>
              <tr><td>決定・調べる</td><td>Z / Enter / A ボタン</td></tr>
              <tr><td>メニュー</td><td>X / Esc / MENU ボタン</td></tr>
            </table>
            <a class="btn btn-primary" href={play}>▶ PLAY</a>
          </div>
          <div class="game-shot panel">
            <h3>見どころ</h3>
            <p>・428 教員室：木村先生から研究室の話を聞く</p>
            <p>・414 実験室：成膜装置から電子顕微鏡まで {equipment.length} 点の装置</p>
            <p>・401 学生居室：学生と話す。本棚には論文 {publications.length} 件</p>
            <p>・廊下の掲示板：最新のお知らせ</p>
            <p class="en">※ 本ゲームの絵はすべて自作です。文章データは本サイトと共通で、更新は同じ手順で行えます。</p>
          </div>
        </div>
      </div>
    </section>

    <!-- ④ LINE UP -->
    <section class="section" id="lineup">
      <div class="wrap">
        <div class="sec-head"><h2>LINE UP</h2><span>コンテンツ一覧</span></div>
        <ul class="cards">
          {lineup.map((c, i) => (
            <li class="card">
              <span class="num">{String(i + 1).padStart(2, '0')} / {c.en}</span>
              <h3>{c.label}</h3>
              <p>{c.desc}</p>
              <a class="btn" href={c.href}>MORE</a>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <footer class="footer">
      <div class="wrap">
        <div><div class="lab">{site.labName}｜{site.labNameAlt}</div>{site.labNameEn}<br />{site.universityEn}</div>
        <div>&copy; {new Date().getFullYear()} M2D Lab</div>
      </div>
    </footer>

    <script is:inline id="game-data" type="application/json" set:html={json}></script>
    <script is:inline type="module" src={withBase('/game/main.js')}></script>
    <script is:inline type="module" src={withBase('/home.js')}></script>
  </body>
</html>
