---
import Base from '../layouts/Base.astro';
import site from '../data/site.json';
---
<Base title="進学・配属希望の方へ">
  <h1>進学・配属希望の方へ</h1>
  <h2>学部生（研究室配属）の方へ</h2>
  <p>（記入: 配属の流れ、見学の受け入れ、求める学生像）</p>
  <h2>大学院進学を希望する方へ</h2>
  <p>（記入: 入試情報へのリンク、研究室見学、事前連絡の方法）</p>
  <h2>よくある質問</h2>
  <p>（記入）</p>
  <h2>連絡先</h2>
  <p>{site.email}</p>
</Base>
